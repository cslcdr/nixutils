#
# git config --global --add include.path 'path/to/gitconfig'
#

[alias]
	a = add
	b = branch
	bb = branch -a
	c = commit
	ck = checkout
	d = diff -w
	dd = diff -w HEAD
	f = fetch
	l = log --graph --decorate --oneline
	ll = lll --oneline
	lll = log --graph --decorate --all
	pl = pull
	ps = push
	r = reset
	s = status -sb
	u = remote update --prune

[core]
	editor = vim -u path/to/vimrc
	pager = less -i
	ignoreCase = false

[credential]
	helper = store
	interactive = false
